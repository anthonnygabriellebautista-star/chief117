# username_generator.py

# Ask the user for their full name
full_name = input("Enter your full name: ")

# Split the name into parts
names = full_name.split()

# Check if the user entered at least first and last name
if len(names) < 2:
    print("Please enter both first name and last name.")
else:
    # Get first and last name
    first_name = names[0]
    last_name = names[-1]

    # Ask for birth year
    birth_year = input("Enter your birth year (example: 1998): ")

    # Create username
    username = first_name[:3].lower() + last_name[:3].lower() + birth_year[-2:]

    # Show the result
    print("Your username is:", username)
